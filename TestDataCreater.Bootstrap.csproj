  <ItemGroup>
    <_BootstrapFile1 Include="# TestDataCreater" />
    <_BootstrapFile1 Include="`TestDataCreater` は、クエリ結果セットのテストデータを GUI で編集し、C# の `HashMap` 初期化コードとして出力する WinForms アプリです。" />
    <_BootstrapFile1 Include="1 行の結果セットは `new HashMap`、複数行の結果セットは `new HashMap&lt;HashMap&gt;` として出力します。複数行の場合、外側の key は現在の表示順に従って `0, 1, 2...` に振り直されます。" />
    <_BootstrapFile1 Include="## 動作環境" />
    <_BootstrapFile1 Include="- .NET 9 SDK" />
    <_BootstrapFile1 Include="- Windows 環境" />
    <_BootstrapFile1 Include="- WinForms UI の起動は Windows が必要です" />
    <_BootstrapFile1 Include="macOS / Linux でも Windows ターゲットの restore / build は可能ですが、画面の起動確認は Windows 上で行ってください。" />
    <_BootstrapFile1 Include="## 導入手順" />
    <_BootstrapFile1 Include="GitHub から取得できる場合:" />
    <_BootstrapFile1 Include="```bash" />
    <_BootstrapFile1 Include="git clone https://github.com/SSsan-00/testdata-creater.git" />
    <_BootstrapFile1 Include="cd testdata-creater" />
    <_BootstrapFile1 Include="dotnet build TestDataCreater.sln" />
    <_BootstrapFile1 Include="```" />
    <_BootstrapFile1 Include="リポジトリをダウンロードできない場合:" />
    <_BootstrapFile1 Include="1. 空のフォルダを作成します。" />
    <_BootstrapFile1 Include="2. [TestDataCreater.Bootstrap.csproj](TestDataCreater.Bootstrap.csproj) だけをそのフォルダへコピーします。" />
    <_BootstrapFile1 Include="3. 次のコマンドを実行します。" />
    <_BootstrapFile1 Include="```bash" />
    <_BootstrapFile1 Include="dotnet build TestDataCreater.Bootstrap.csproj" />
    <_BootstrapFile1 Include="dotnet build TestDataCreater.sln" />
    <_BootstrapFile1 Include="```" />
    <_BootstrapFile1 Include="bootstrap は solution、Core プロジェクト、WinForms プロジェクト、ソースファイルを現在のフォルダへ展開します。検証用ソースは展開しません。" />
    <_BootstrapFile1 Include="既存ファイルがある場合、bootstrap は上書きしません。再生成したい場合は次を実行してください。" />
    <_BootstrapFile1 Include="```bash" />
    <_BootstrapFile1 Include="dotnet build TestDataCreater.Bootstrap.csproj /p:BootstrapOverwrite=true" />
    <_BootstrapFile1 Include="```" />
    <_BootstrapFile1 Include="## 起動方法" />
    <_BootstrapFile1 Include="Windows 上で次のコマンドを実行します。" />
    <_BootstrapFile1 Include="```bash" />
    <_BootstrapFile1 Include="dotnet run --project src/TestDataCreater/TestDataCreater.csproj" />
    <_BootstrapFile1 Include="```" />
    <_BootstrapFile1 Include="Visual Studio を使う場合は `TestDataCreater.sln` を開き、`TestDataCreater` プロジェクトを起動プロジェクトに設定して実行してください。" />
    <_BootstrapFile1 Include="## 使い方" />
    <_BootstrapFile1 Include="1. 左側の `ワークスペース` で結果セットを選択します。" />
    <_BootstrapFile1 Include="2. `追加` で結果セットを追加します。" />
    <_BootstrapFile1 Include="3. 画面上部の `結果セット名` で名前を変更します。" />
    <_BootstrapFile1 Include="4. グリッド左端の `+` で行を追加します。" />
    <_BootstrapFile1 Include="5. 各行の左端にある `-` で行を削除します。" />
    <_BootstrapFile1 Include="6. グリッド右端の `+` で列を追加します。" />
    <_BootstrapFile1 Include="7. グリッド最上段の各列にある `-` で列を削除します。" />
    <_BootstrapFile1 Include="8. グリッドのセルに値を入力します。" />
    <_BootstrapFile1 Include="9. グリッド上部の `列名` で選択列の名前を変更します。" />
    <_BootstrapFile1 Include="10. グリッド上部の `型` で選択セルの値型を指定します。" />
    <_BootstrapFile1 Include="11. `プレビュー` で C# 出力内容を確認します。" />
    <_BootstrapFile1 Include="12. `コピー` でプレビュー内容をクリップボードへコピーします。" />
    <_BootstrapFile1 Include="行をドラッグすると表示順を変更できます。列はヘッダーをドラッグして並び替えできます。" />
    <_BootstrapFile1 Include="プレビューとコピーは常に現在の全レコードを出力します。セル入力中もプレビューは入力内容に追従します。" />
    <_BootstrapFile1 Include="`型` の候補は入力値に応じて絞り込まれます。たとえば `01` のような文字列は数値型として選択できません。" />
    <_BootstrapFile1 Include="## 出力形式" />
    <_BootstrapFile1 Include="1 行のみの場合:" />
    <_BootstrapFile1 Include="```csharp" />
    <_BootstrapFile1 Include="var data = new HashMap" />
    <_BootstrapFile1 Include="{" />
    <_BootstrapFile1 Include="    { &quot;USER_ID&quot;, 1 }," />
    <_BootstrapFile1 Include="    { &quot;USER_NAME&quot;, &quot;Alice&quot; }," />
    <_BootstrapFile1 Include="}%3B" />
    <_BootstrapFile1 Include="```" />
    <_BootstrapFile1 Include="複数行の場合:" />
    <_BootstrapFile1 Include="```csharp" />
    <_BootstrapFile1 Include="var data = new HashMap&lt;HashMap&gt;" />
    <_BootstrapFile1 Include="{" />
    <_BootstrapFile1 Include="    { 0, new HashMap" />
    <_BootstrapFile1 Include="        {" />
    <_BootstrapFile1 Include="            { &quot;USER_ID&quot;, 1 }," />
    <_BootstrapFile1 Include="            { &quot;USER_NAME&quot;, &quot;Alice&quot; }," />
    <_BootstrapFile1 Include="        }" />
    <_BootstrapFile1 Include="    }," />
    <_BootstrapFile1 Include="    { 1, new HashMap" />
    <_BootstrapFile1 Include="        {" />
    <_BootstrapFile1 Include="            { &quot;USER_ID&quot;, 2 }," />
    <_BootstrapFile1 Include="            { &quot;USER_NAME&quot;, &quot;Bob&quot; }," />
    <_BootstrapFile1 Include="        }" />
    <_BootstrapFile1 Include="    }," />
    <_BootstrapFile1 Include="}%3B" />
    <_BootstrapFile1 Include="```" />
    <_BootstrapFile1 Include="複数行出力時の外側 key は、GUI 上の表示順に従って `0` から連番で再採番します。" />
    <_BootstrapFile1 Include="## 値型" />
    <_BootstrapFile1 Include="セルごとに次の型を選択できます。" />
    <_BootstrapFile1 Include="- `String`" />
    <_BootstrapFile1 Include="- `Int32`" />
    <_BootstrapFile1 Include="- `Int64`" />
    <_BootstrapFile1 Include="- `Decimal`" />
    <_BootstrapFile1 Include="- `Double`" />
    <_BootstrapFile1 Include="- `Boolean`" />
    <_BootstrapFile1 Include="- `DateTime`" />
    <_BootstrapFile1 Include="- `Guid`" />
    <_BootstrapFile1 Include="- `Null`" />
    <_BootstrapFile1 Include="- `DbNull`" />
    <_BootstrapFile1 Include="- `CustomExpression`" />
    <_BootstrapFile1 Include="`CustomExpression` は任意の C# 式をそのまま出力するための型です。たとえば `OrderStatus.Completed` や `new Money(1200, &quot;JPY&quot;)` のような、プロジェクト固有の型や enum を使う場合に指定します。" />
    <_BootstrapFile1 Include="## データ保存" />
    <_BootstrapFile1 Include="入力した workspace はアプリ終了時や編集操作時に自動保存されます。保存先はユーザーのアプリケーションデータフォルダ配下の `TestDataCreater/workspace.json` です。" />
    <_BootstrapFile1 Include="アプリを再起動すると、前回の workspace、行、列、セル値、値型が復元されます。" />
    <_BootstrapFile1 Include="## 開発者向け" />
    <_BootstrapFile1 Include="通常ビルド:" />
    <_BootstrapFile1 Include="```bash" />
    <_BootstrapFile1 Include="dotnet build TestDataCreater.sln" />
    <_BootstrapFile1 Include="```" />
    <_BootstrapFile1 Include="テスト実行:" />
    <_BootstrapFile1 Include="```bash" />
    <_BootstrapFile1 Include="dotnet test TestDataCreater.sln" />
    <_BootstrapFile1 Include="```" />
    <_BootstrapFile1 Include="検証用プロジェクトは通常リポジトリでの開発向けです。bootstrap で展開されるソースには含めていません。" />
  </ItemGroup>
